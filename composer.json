{
    "name": "stefanrydin/stockpicker",
    "description": "Personal nightly data-collection engine for Avanza and Nordnet owner counts.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "monolog/monolog": "^3.11",
        "robmorgan/phinx": "^0.16.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "Stockpicker\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Stockpicker\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cakephp/plugin-installer": false
        }
    }
}
