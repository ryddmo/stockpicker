<?php

/**
 * Stockpicker configuration template.
 *
 * Copy to config.php at the project root (above public_html/), fill in the
 * real values, and keep config.php out of git. Loaded through Stockpicker\Config.
 *
 * For local development the db values point at the MariaDB service in
 * docker-compose.yml (docker compose up -d).
 *
 * On the Loopia server this file is created by hand and never rsynced — use the
 * real database (mysql684.loopia.se / ryddmo_se / …) and a strong cron_token.
 * See docs/deploy.md ("One-time setup", step C.2) for the full procedure.
 */

return [
    'db' => [
        'host' => '127.0.0.1',
        'name' => 'stockpicker',
        'user' => 'stockpicker',
        'pass' => 'stockpicker',
        'charset' => 'utf8mb4',
    ],

    // Shared secret for the /cron/* endpoints, compared with hash_equals().
    'cron_token' => 'change-me',

    // Börsdata REST API key (https://borsdata.se, "Mina sidor" -> API). Used
    // only to define the tradable Swedish universe (Story 2.1 BorsdataAdapter),
    // never for owner counts. A universe sync is ~2 calls/night; the free tier
    // caps at 100 calls / 10 s.
    'borsdata' => [
        'api_key' => 'change-me',
    ],

    // Log file, relative to the project root or absolute. Must be outside public_html/.
    'log_path' => 'var/log/stockpicker.log',
];
